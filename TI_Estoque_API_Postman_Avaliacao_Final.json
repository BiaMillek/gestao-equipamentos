    {
      "name": "03 - Equipamentos",
      "item": [
        {
          "name": "Criar Equipamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook Dell Latitude\",\n  \"brand\": \"Dell\",\n  \"model\": \"Latitude 5440\",\n  \"serial_number\": \"SN-{{$timestamp}}-{{$randomInt}}\",\n  \"status\": \"disponivel\",\n  \"location_id\": \"{{locationId}}\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria equipamento vinculado ao local. Salva equipmentId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.id).to.be.a('string');",
                  "pm.expect(data.status).to.eql('disponivel');",
                  "pm.environment.set('equipmentId', data.id);",
                  "pm.environment.set('equipmentSerial', data.serial_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar Equipamentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an('array');",
                  "const item = pm.response.json().find(e => e.id === pm.environment.get('equipmentId'));",
                  "pm.expect(item).to.exist;"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar Equipamento por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipments/{{equipmentId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.id).to.eql(pm.environment.get('equipmentId'));",
                  "pm.expect(data.location).to.exist;"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar Equipamento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipments/{{equipmentId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook Dell Latitude - Atualizado\",\n  \"brand\": \"Dell\",\n  \"model\": \"Latitude 5440\",\n  \"serial_number\": \"{{equipmentSerial}}\",\n  \"status\": \"manutencao\",\n  \"location_id\": \"{{locationId}}\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
