{
  "info": {
    "_postman_id": "5740e623-6785-4a97-b85b-468711df6f12",
    "name": "TI Estoque API - Avaliação Final",
    "description": "Coleção de testes funcionais da API TI Estoque. Execute em sequência: Locais > Técnicos > Equipamentos > Validações. Configure um ambiente com baseUrl (ex.: http://localhost:3000). As requisições de exclusão devem ser executadas por último, pois removem os registros criados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Locais",
      "item": [
        {
          "name": "Criar Local",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Almoxarifado TI {{$randomInt}}\",\n  \"description\": \"Sala de equipamentos\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria um local e salva locationId no ambiente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.id).to.be.a('string');",
                  "pm.environment.set('locationId', data.id);",
                  "pm.environment.set('locationName', data.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar Locais",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar Local por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().id).to.eql(pm.environment.get('locationId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar Local",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Almoxarifado TI - Atualizado\",\n  \"description\": \"Local atualizado pelo Postman\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().name).to.include('Atualizado');"
                ]
              }
            }
          ]
        }
      ]
